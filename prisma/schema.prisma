generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRole {
  ADMIN
  CUSTOMER
  VENDOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name") @db.VarChar(255)
  lastName  String   @map("last_name") @db.VarChar(255)
  username  String   @unique @db.VarChar(255)
  gender    Gender
  email     String   @unique @db.VarChar(255)
  phone     String
  password  String   @db.VarChar(255)
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  addresses Address[]
  vendor    Vendor?

  @@map("users")
}

model Vendor {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id") @db.Uuid
  storeName   String   @map("store_name") @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  products Product[]

  @@map("vendors")
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  street    String   @db.VarChar(255)
  city      String   @db.VarChar(255)
  state     String   @db.VarChar(255)
  isDefault Boolean  @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Product {
  id               Int           @id @default(autoincrement())
  vendorId         String        @map("vendor_id")
  name             String        @db.VarChar(255)
  slug             String        @db.VarChar(255)
  shortDescription String?       @map("short_description") @db.VarChar(1000)
  description      String        @db.Text
  categoryId       Int?          @map("category_id")
  thumbnail        String
  images           String[]
  sku              String        @db.VarChar(255)
  price            Decimal       @db.Decimal(12, 2)
  comparePrice     Decimal?      @map("compare_price") @db.Decimal(12, 2)
  stock            Int           @default(0)
  specs            Json?         @db.JsonB
  rating           Float         @default(0) @db.DoublePrecision
  status           ProductStatus
  isActive         Boolean       @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  relatedProducts Product[] @relation("RelatedProducts")
  relatedTo       Product[] @relation("RelatedProducts")
  tags            Tag[]

  @@unique([vendorId, slug])
  @@index([vendorId])
  @@map("products")
}

model Category {
  id Int @id @default(autoincrement())

  products Product[]

  @@map("category")
}

model Tag {
  id Int @id @default(autoincrement())

  products Product[]

  @@map("tags")
}

model Cart {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("carts")
}

model CartItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("cart_items")
}

model Order {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("orders")
}

model OrderItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("order_items")
}

model Review {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("reviews")
}
